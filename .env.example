# Copy this file to .env for local development (.env is git-ignored).
# For GitHub Pages, set the same value as a repository VARIABLE (not a secret):
#   Settings → Secrets and variables → Actions → Variables → New repository variable
#   Name: VITE_FORMSPREE_ENDPOINT
#
# Create a form at https://formspree.io, then copy its endpoint URL here.
# It looks like: https://formspree.io/f/abcdwxyz
# This is a public submission URL, not a private key.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
